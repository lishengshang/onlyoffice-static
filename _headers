# Cloudflare Pages 响应头：x2t.wasm 以 brotli 形态存储，必须声明编码才能被浏览器解压
# 同时覆盖原始路径与 .br 路径（_headers 的匹配基准在 rewrite 前后行为以实测为准）
/9.3.0.133-24e34b4f401d86dfb31def637358e2fa/vendor/sdkjs/common/wasm/x2t/x2t.wasm
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable

/9.3.0.133-24e34b4f401d86dfb31def637358e2fa/vendor/sdkjs/common/wasm/x2t/x2t.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable

# SPA 入口：HTML 壳需重新验证（引用的是带 hash 的静态资源）
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/onlyoffice.html
  Cache-Control: no-cache

# /assets/ 是引擎契约静态文件（favicon、empty*.pdf），无 hash：短缓存
/assets/*
  Cache-Control: max-age=3600

# /app/ 是 Vite 带 hash 的应用产物（内容寻址）：长缓存
/app/*
  Cache-Control: public, max-age=31536000, immutable

# 引擎版本目录：内容寻址（目录名含版本哈希），长缓存
/9.3.0.133-24e34b4f401d86dfb31def637358e2fa/*
  Cache-Control: public, max-age=31536000, immutable
