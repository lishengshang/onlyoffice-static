{
    "name": "onlyoffice-static-shell",
    "version": "0.2.0",
    "private": true,
    "type": "module",
    "description": "onlyoffice-static 壳层工程：Vue 3 SPA，产物布局与仓库根目录一致",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build && node scripts/copy-static.mjs",
        "preview": "vite preview",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "smoke": "node tests/smoke-test.mjs",
        "smoke:embed": "node tests/embed-smoke.mjs",
        "smoke:deeplink": "node tests/deep-link-save-test.mjs"
    },
    "dependencies": {
        "@vueuse/core": "^13.0.0",
        "pinia": "^3.0.0",
        "vue": "^3.5.0",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/tsconfig": "^0.7.0",
        "eslint": "^9.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-vue": "^10.0.0",
        "globals": "^16.0.0",
        "prettier": "^3.0.0",
        "sirv": "^3.0.0",
        "typescript": "~5.9.0",
        "typescript-eslint": "^8.0.0",
        "vite": "^7.1.0",
        "vitest": "^5.0.0",
        "vue-tsc": "^3.0.0"
    }
}
